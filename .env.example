# Copy this file to .env and fill in real values. .env is git-ignored;
# never commit real API keys. Values here are placeholders only.
# Real environment variables (e.g. exported in your shell) always take
# precedence over whatever is in .env.

# --- LLM backend ---
CA_LLM_BACKEND=ollama
# CA_LLM_BASE_URL=http://localhost:11434/v1
# CA_LLM_MODEL=qwen2.5:14b-instruct
# CA_LLM_API_KEY=sk-replace-with-your-own-key
# CA_LLM_TIMEOUT_S=30
# CA_LLM_MAX_RETRIES=12
# CA_LLM_RETRY_BUDGET_S=1800
# CA_LLM_RATE_LIMIT_BACKOFF_S=60
# Total per-question budget, including all model calls and quota waits:
# CA_ANALYSIS_QUESTION_TIMEOUT_S=1800
# CA_LLM_MIN_INTERVAL_S=0
# CA_LLM_BACKOFF_BASE_S=0.5
# CA_LLM_BACKOFF_CAP_S=20
# Prompt preflight budget, including schema/example and a framing allowance.
# Defaults to 5500, leaving room for 2048 output tokens under an 8000 TPM tier.
# CA_LLM_MAX_INPUT_TOKENS=5500
# For a higher-context model/account, raise this explicitly (e.g. 32768).
# Leave room for output tokens; cumulative question and retry budgets still apply.

# --- Embedding backend ---
CA_EMBEDDING_BACKEND=ollama
# CA_EMBEDDING_BASE_URL=http://localhost:11434/v1
# CA_EMBEDDING_MODEL=nomic-embed-text
# CA_EMBEDDING_API_KEY=sk-replace-with-your-own-key
# CA_EMBEDDING_TIMEOUT_S=30
# CA_EMBEDDING_MAX_RETRIES=12
# CA_EMBEDDING_RETRY_BUDGET_S=1800
# CA_EMBEDDING_RATE_LIMIT_BACKOFF_S=60
# CA_EMBEDDING_MIN_INTERVAL_S=0
# CA_EMBEDDING_BACKOFF_BASE_S=0.5
# CA_EMBEDDING_BACKOFF_CAP_S=20

# Native local embeddings (real ONNX inference; no API key or server):
# CA_EMBEDDING_BACKEND=fastembed
# CA_EMBEDDING_BASE_URL=local://fastembed
# CA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Public model weights download into .index/models on first use.
# Do not combine this backend with a hosted endpoint/model; use openai below.

# Hosted OpenAI-compatible examples:
# Groq LLM free tier (explicitly zero-rated in cost reporting while within its rate limits)
# CA_LLM_BACKEND=openai
# CA_LLM_BASE_URL=https://api.groq.com/openai/v1
# CA_LLM_MODEL=openai/gpt-oss-120b
# CA_LLM_API_KEY=gsk-replace-with-your-own-key
#
# SiliconFlow embeddings / LLMs
# CA_EMBEDDING_BACKEND=openai
# CA_EMBEDDING_BASE_URL=https://api.siliconflow.com/v1
# CA_EMBEDDING_MODEL=BAAI/bge-m3
# CA_EMBEDDING_API_KEY=sk-replace-with-your-own-key
# CA_LLM_BACKEND=openai
# CA_LLM_BASE_URL=https://api.siliconflow.com/v1
# CA_LLM_MODEL=Qwen/Qwen3.5-9B
# CA_LLM_API_KEY=sk-replace-with-your-own-key

# --- Observability ---
# JSON logs always persist locally. OTel additionally prints spans to stderr
# and writes rotating logs/otel-spans.jsonl. Langfuse enables OTel automatically.
CA_OTEL_ENABLED=0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# CA_LOG_MAX_BYTES=10485760
# CA_LOG_BACKUP_COUNT=5
# Run ./setup.sh --langfuse to create a private .env.langfuse and local dashboard.
# Explicit environment/.env values override .env.langfuse. Only loopback URLs
# are allowed; traces include prompts/evidence and must not go to hosted servers.
# CA_LANGFUSE_ENABLED=1
# LANGFUSE_BASE_URL=http://127.0.0.1:3100
# LANGFUSE_PROJECT_ID=contract-analyzer
# LANGFUSE_PUBLIC_KEY=pk-lf-replace
# LANGFUSE_SECRET_KEY=sk-lf-replace
# CA_OBS_ENVIRONMENT=development
